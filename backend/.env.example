MONGODB_URI=your_mongodb_connection_string
SEED_MODE=upsert
SEED_LIMIT=200
SEED_DRY_RUN=true
SEED_SOURCE_DIR=seed/catalog-import/source
CLOUDINARY_UPLOAD_ENABLED=false
JWT_SECRET=your_jwt_secret
ORIGIN=https://your-frontend-project.vercel.app
ALLOW_VERCEL_PREVIEWS=false
PRODUCTION=true
NODE_ENV=production
PORT=8000
COOKIE_EXPIRATION_DAYS=7
OTP_EXPIRATION_TIME=300000
LOGIN_TOKEN_EXPIRATION=7d
PASSWORD_RESET_TOKEN_EXPIRATION=10m
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=your_mock_payment_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_SECRET=your_razorpay_webhook_or_signature_secret
PAYU_KEY=your_payu_key
PAYU_SALT=your_payu_salt
PAYU_ENV=test
